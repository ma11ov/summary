{
    "manifest_version": 3,
    "name": "AI Page Summarizer",
    "description": "Создает краткое содержание любой статьи с помощью AI.",
    "version": "0.1.0",
  
    "permissions": [
      "storage",
      "activeTab",
      "scripting"
    ],
  
    "background": {
      "service_worker": "service-worker.js"
    },
  
    "action": {
      "default_title": "Суммаризировать страницу"
    },
  
    "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }